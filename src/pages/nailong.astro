---
import BaseHead from '@/components/BaseHead.astro'
import { images } from '@/components/nailong/images'
import ThemeProvider from '@/components/ThemeProvider.astro'

import '@/assets/styles/app.css'

export const prerender = true
---

<html lang='zh-CN'>
  <head>
    <BaseHead title='奶龙彩蛋' description='滚动，看看奶龙如何散开，又重新织合。' />
    <ThemeProvider />
    <script is:inline src='/scripts/nailong-entry.js'></script>
    <meta name='robots' content='noindex' />
    <style>
      :global(html) {
        background: #f7f5ed;
        color: #18181b;
      }
      :global(html.dark) {
        background: #0b0b10;
        color: #fafafa;
      }
      body {
        margin: 0;
        font-family: 'Satoshi', sans-serif;
      }
      main {
        width: 100%;
        height: 100svh;
        min-height: 320px;
        position: relative;
      }
      main[data-ready] {
        overflow: hidden;
        touch-action: none;
        cursor: grab;
      }
      main[data-ready]:not([data-interactive]) {
        cursor: default;
      }
      main[data-dragging] {
        cursor: grabbing;
      }
      :global(#nailong-stage canvas) {
        display: block;
        width: 100%;
        height: 100%;
      }
      header,
      footer {
        position: fixed;
        left: 0;
        right: 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 28px 36px;
        pointer-events: none;
        z-index: 2;
      }
      header {
        top: 0;
      }
      footer {
        bottom: 0;
        padding-bottom: max(28px, env(safe-area-inset-bottom));
      }
      a,
      button {
        pointer-events: auto;
        color: inherit;
        text-decoration: none;
      }
      a:focus-visible,
      button:focus-visible {
        outline: 2px solid currentColor;
        outline-offset: 6px;
      }
      .back,
      .hint,
      .caption {
        font-size: 12px;
        letter-spacing: 0.04em;
      }
      .back span {
        margin-right: 6px;
      }
      .brand {
        font-weight: 700;
        letter-spacing: 0.12em;
        font-size: 13px;
      }
      .edition {
        font-size: 10px;
        opacity: 0.45;
        font-weight: 400;
      }
      button {
        background: none;
        border: 0;
        padding: 8px;
        font-size: 22px;
        cursor: pointer;
      }
      .counter {
        font-variant-numeric: tabular-nums;
        font-size: 13px;
      }
      .divider,
      .hint,
      .caption {
        opacity: 0.5;
      }
      .hint,
      .caption {
        width: 30%;
      }
      .caption {
        text-align: right;
      }
      .gallery {
        display: flex;
        gap: 24px;
        align-items: center;
        height: 100%;
        overflow-x: auto;
        padding: 90px 24px;
        box-sizing: border-box;
      }
      .gallery img {
        width: min(70vw, 600px);
        aspect-ratio: 5 / 3;
        object-fit: cover;
        height: auto;
        flex: none;
        border-radius: 12px;
      }
      [data-ready] .gallery {
        display: none;
      }
      .entry {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 1;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        gap: 22px;
        background: #f7f5ed;
        pointer-events: none;
      }
      :global(html.dark) .entry {
        background: #0b0b10;
      }
      :global(html[data-nailong-entry]) .entry {
        display: flex;
      }
      :global(html[data-nailong-entry='loading']) .gallery {
        visibility: hidden;
      }
      :global(html[data-nailong-entry='ready']) .entry,
      :global(html[data-nailong-entry='fallback']) .entry {
        opacity: 0;
        visibility: hidden;
        transition:
          opacity 150ms ease,
          visibility 150ms;
      }
      :global(html[data-nailong-entry='fallback']) .gallery {
        animation: gallery-reveal 150ms ease;
      }
      :global(html[data-nailong-entry='ready']) .entry {
        background: transparent;
        transition:
          opacity 650ms ease,
          visibility 650ms;
      }
      .entry-weave {
        display: flex;
        flex-direction: column;
        gap: 10px;
        width: min(32vw, 240px);
        opacity: 0.3;
        animation: weave-grow 650ms cubic-bezier(0.22, 0.61, 0.36, 1) both;
        transition:
          width 650ms cubic-bezier(0.22, 0.61, 0.36, 1),
          gap 650ms cubic-bezier(0.22, 0.61, 0.36, 1);
      }
      :global(html[data-nailong-entry='ready']) .entry-weave {
        animation: weave-handoff 650ms cubic-bezier(0.22, 0.61, 0.36, 1) both;
      }
      .entry-weave span {
        height: 1px;
        background: currentColor;
        animation: weave-breathe 1100ms ease-in-out infinite alternate;
      }
      .entry-weave span:nth-child(2n) {
        animation-delay: -550ms;
      }
      .entry-label {
        position: absolute;
        top: calc(50% + 46px);
        margin: 0;
        font-size: 12px;
        letter-spacing: 0.08em;
        opacity: 0;
        visibility: hidden;
        transition: opacity 150ms;
      }
      :global(html[data-nailong-waiting]) .entry-label {
        visibility: visible;
        opacity: 0.5;
      }
      @keyframes weave-grow {
        from {
          width: var(--weave-start-width, 12px);
          gap: var(--weave-start-gap, 2px);
          opacity: var(--weave-start-opacity, 0);
        }
        to {
          width: min(32vw, 240px);
          gap: 10px;
          opacity: 0.3;
        }
      }
      @keyframes weave-handoff {
        from {
          width: var(--weave-width);
          gap: var(--weave-gap);
          opacity: var(--weave-opacity);
        }
        to {
          width: min(70vw, 760px);
          gap: 20px;
          opacity: 0;
        }
      }
      @keyframes weave-breathe {
        from {
          transform: scaleX(0.88);
          opacity: 0.35;
        }
        to {
          transform: scaleX(1);
          opacity: 1;
        }
      }
      @keyframes gallery-reveal {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        :global(html[data-nailong-entry='ready']) .entry {
          transition:
            opacity 150ms ease,
            visibility 150ms;
        }
        .entry-weave {
          transition: none;
          animation: none;
        }
        :global(html[data-nailong-entry='ready']) .entry-weave {
          width: 48px;
          gap: 5px;
          animation: none;
        }
        .entry-weave span {
          animation: none;
        }
      }
      @media (max-width: 600px) {
        header,
        footer {
          padding-left: 20px;
          padding-right: 20px;
        }
        .edition {
          display: none;
        }
        .brand {
          font-size: 11px;
        }
        .hint {
          font-size: 10px;
          width: 40%;
        }
        .caption {
          width: 25%;
          font-size: 10px;
        }
      }
    </style>
  </head>
  <body>
    <main id='nailong-stage' data-images={JSON.stringify(images)} aria-label='奶龙图片卷轴'>
      <div class='gallery' id='nailong-fallback' tabindex='0' aria-label='可横向滚动的奶龙图库'>
        {
          images.map((image, index) => (
            <img
              src={image.src}
              alt={image.name}
              loading={index < 3 ? 'eager' : 'lazy'}
              width={image.width}
              height={image.height}
            />
          ))
        }
        {images.length === 0 && <p>奶龙还没到场，稍后再来看看。</p>}
      </div>
    </main>
    <div class='entry' aria-live='polite' role='status'>
      <div class='entry-weave' aria-hidden='true'>{Array.from({ length: 6 }, () => <span />)}</div>
      <p class='entry-label'>正在展开卷轴</p>
    </div>
    <header>
      <a href='/' class='back' aria-label='返回首页'><span aria-hidden='true'>↖</span> 返回首页</a>
      <span class='brand'>NAILONG<span class='edition'> / SECRET REEL</span></span>
      <button id='nailong-theme' type='button' aria-label='切换明暗主题'>◐</button>
    </header>
    <footer>
      <span class='hint'>滚动 / 滑动 / ← →</span>
      <span class='counter'
        ><span id='nailong-current'>{images.length ? '01' : '00'}</span><span class='divider'>
          /
        </span>{String(images.length).padStart(2, '0')}</span
      >
      <span class='caption' id='nailong-caption'>{images[0]?.name ?? '奶龙彩蛋'}</span>
    </footer>
    <script>
      import { mountReel } from '@/components/nailong/reel'

      mountReel()
    </script>
  </body>
</html>
