---
import type { ImageMetadata } from 'astro'
import { getImage } from 'astro:assets'

import BaseHead from '@/components/BaseHead.astro'
import ThemeProvider from '@/components/ThemeProvider.astro'

import '@/assets/styles/app.css'

export const prerender = true
const files = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/nailong/*.{png,jpg,jpeg,webp,PNG,JPG,JPEG,WEBP}',
  { eager: true }
)
const images = await Promise.all(
  Object.entries(files)
    .sort(([a], [b]) => a.localeCompare(b, 'zh-CN', { numeric: true }))
    .map(async ([path, { default: image }]) => ({
      src: (await getImage({ src: image, width: Math.min(image.width, 1600), format: 'webp' })).src,
      name: path
        .split('/')
        .pop()!
        .replace(/\.[^.]+$/, ''),
      width: image.width,
      height: image.height
    }))
)
---

<html lang='zh-CN'>
  <head>
    <BaseHead title='奶龙彩蛋' description='滚动，看看奶龙如何散开，又重新织合。' />
    <ThemeProvider />
    <meta name='robots' content='noindex' />
    <style>
      :global(html) {
        background: #f7f5ed;
        color: #18181b;
      }
      :global(html.dark) {
        background: #0b0b10;
        color: #fafafa;
      }
      body {
        margin: 0;
        font-family: 'Satoshi', sans-serif;
      }
      main {
        width: 100%;
        height: 100svh;
        min-height: 320px;
        position: relative;
      }
      main[data-ready] {
        overflow: hidden;
        touch-action: none;
        cursor: grab;
      }
      main[data-dragging] {
        cursor: grabbing;
      }
      :global(#nailong-stage canvas) {
        display: block;
        width: 100%;
        height: 100%;
      }
      header,
      footer {
        position: fixed;
        left: 0;
        right: 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 28px 36px;
        pointer-events: none;
        z-index: 2;
      }
      header {
        top: 0;
      }
      footer {
        bottom: 0;
        padding-bottom: max(28px, env(safe-area-inset-bottom));
      }
      a,
      button {
        pointer-events: auto;
        color: inherit;
        text-decoration: none;
      }
      a:focus-visible,
      button:focus-visible {
        outline: 2px solid currentColor;
        outline-offset: 6px;
      }
      .back,
      .hint,
      .caption {
        font-size: 12px;
        letter-spacing: 0.04em;
      }
      .back span {
        margin-right: 6px;
      }
      .brand {
        font-weight: 700;
        letter-spacing: 0.12em;
        font-size: 13px;
      }
      .edition {
        font-size: 10px;
        opacity: 0.45;
        font-weight: 400;
      }
      button {
        background: none;
        border: 0;
        padding: 8px;
        font-size: 22px;
        cursor: pointer;
      }
      .counter {
        font-variant-numeric: tabular-nums;
        font-size: 13px;
      }
      .divider,
      .hint,
      .caption {
        opacity: 0.5;
      }
      .hint,
      .caption {
        width: 30%;
      }
      .caption {
        text-align: right;
      }
      .gallery {
        display: flex;
        gap: 24px;
        align-items: center;
        height: 100%;
        overflow-x: auto;
        padding: 90px 24px;
        box-sizing: border-box;
      }
      .gallery img {
        width: min(70vw, 600px);
        aspect-ratio: 5 / 3;
        object-fit: cover;
        height: auto;
        flex: none;
        border-radius: 12px;
      }
      [data-ready] .gallery {
        display: none;
      }
      @media (max-width: 600px) {
        header,
        footer {
          padding-left: 20px;
          padding-right: 20px;
        }
        .edition {
          display: none;
        }
        .brand {
          font-size: 11px;
        }
        .hint {
          font-size: 10px;
          width: 40%;
        }
        .caption {
          width: 25%;
          font-size: 10px;
        }
      }
    </style>
  </head>
  <body>
    <main id='nailong-stage' data-images={JSON.stringify(images)} aria-label='奶龙图片卷轴'>
      <div class='gallery' id='nailong-fallback' tabindex='0' aria-label='可横向滚动的奶龙图库'>
        {
          images.map((image) => (
            <img
              src={image.src}
              alt={image.name}
              loading='lazy'
              width={image.width}
              height={image.height}
            />
          ))
        }
        {images.length === 0 && <p>奶龙还没到场，稍后再来看看。</p>}
      </div>
    </main>
    <header>
      <a href='/' class='back' aria-label='返回首页'><span aria-hidden='true'>↖</span> 返回首页</a>
      <span class='brand'>NAILONG<span class='edition'> / SECRET REEL</span></span>
      <button id='nailong-theme' type='button' aria-label='切换明暗主题'>◐</button>
    </header>
    <footer>
      <span class='hint'>滚动 / 滑动 / ← →</span>
      <span class='counter'
        ><span id='nailong-current'>{images.length ? '01' : '00'}</span><span class='divider'>
          /
        </span>{String(images.length).padStart(2, '0')}</span
      >
      <span class='caption' id='nailong-caption'>{images[0]?.name ?? '奶龙彩蛋'}</span>
    </footer>
    <script>
      import { mountReel } from '@/components/nailong/reel'

      mountReel()
    </script>
  </body>
</html>
