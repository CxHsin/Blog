---
import { Image } from 'astro:assets'
import { getSafeArchiveCollection, getSafeBlogCollection } from '@/lib/content-guards'
import avatar from 'src/assets/avatar.jpg'

import { PostPreview } from 'astro-pure/components/pages'
import { Quote } from 'astro-pure/advanced'
import { Button, Icon, Label } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import Section from '@/components/home/Section.astro'
import SkillLayout from '@/components/home/SkillLayout.astro'
import LoadingOverlay from '@/components/showcase/LoadingOverlay.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'
import Terminal from '@/components/terminal/Terminal.astro'
import { openSourceProjects } from '@/data/projects'
import config from '@/site-config'

export const prerender = true

const languages = ['TypeScript', 'JavaScript', 'Python', 'SQL', 'C++']
const frontend = ['React', 'Next.js', 'Astro', 'Tailwind CSS', 'UnoCSS']
const backend = ['Node.js', 'Express', 'Supabase', 'PostgreSQL', 'Vercel']
const ai = [
  'Codex',
  'Claude Code',
  'LLM',
  'Transformer',
  'Multi-Agent',
  'RAG',
  'Function Calling',
  'Prompt Engineering'
]
const tools = ['Cursor', 'Git', 'Docker', 'Bun', 'Figma', 'ESLint/Prettier']

const archiveTypeLabels: Record<string, string> = {
  note: '笔记',
  snippet: '片段',
  draft: '草稿',
  idea: '想法',
  research: '研究',
  reference: '参考'
}

const latestNotes = (await getSafeArchiveCollection())
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4)

const latestPosts = (await getSafeBlogCollection())
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 1)
---

<PageLayout meta={{ title: 'Home' }} highlightColor='#659EB9'>
  <LoadingOverlay
    brand='CXIN'
    subtitle='Connecting Scroll Effects'
    durationMs={2200}
    oncePerSite={true}
    storageKey='site-loading-overlay-seen'
  />

  <main class='flex w-full flex-col items-center'>
    <section
      class='animate relative z-50 mb-12 flex flex-col items-center gap-y-6'
      id='content-header'
    >
      <Image
        src={avatar}
        alt='profile'
        class='h-28 w-auto rounded-full border p-1'
        loading='eager'
      />

      <div class='flex flex-col items-center gap-y-4'>
        <h1 class='text-3xl font-bold'>{config.author}</h1>
        <div class='flex flex-wrap justify-center gap-x-7 gap-y-3'>
          <Label title='GitHub' as='a' href='https://github.com/CxHsin' target='_blank'>
            <Icon name='github' class='size-5' slot='icon' />
          </Label>
        </div>
      </div>

      <div class='flex flex-row gap-3'>
        <a
          href='/contact'
          class='flex flex-row items-center gap-x-3 rounded-full border bg-background px-4 py-2 text-sm shadow-sm transition-shadow hover:shadow-md'
        >
          <span class='relative flex items-center justify-center'>
            <span
              class='absolute size-2 animate-ping rounded-full border border-green-400 bg-green-400 opacity-75'
            ></span>
            <span class='size-2 rounded-full bg-green-400'></span>
          </span>
          <p class='font-medium text-muted-foreground'>Contact me</p>
        </a>
      </div>
    </section>

    <div
      id='content'
      class='animate relative z-0 flex w-full min-w-0 max-w-full flex-col gap-y-10 md:w-4/5 lg:w-5/6'
    >
      <div class='-mt-2'>
        <Terminal />
      </div>

      <Section title='About'>
        <p>
          本科在读，正在寻找 agent 相关实习，也持续把兴趣放在 AI 应用、Agent workflow
          和全栈产品实现上。
        </p>
        <p>
          我喜欢把想法快速做成能运行的东西，再一边上线、一边打磨，把抽象概念变成真实可用的产品体验。
        </p>
        <Button title='See more' class='w-fit self-end text-sm' href='/about' style='ahead' />
      </Section>

      <Section title='Blog'>
        {latestPosts.length > 0 ? (
          <ul class='flex flex-col gap-y-1.5 sm:gap-y-2'>
            {latestPosts.map((post) => <PostPreview post={post} />)}
          </ul>
        ) : (
          <p class='text-muted-foreground'>No posts yet.</p>
        )}
        <Button title='Open page' class='w-fit self-end text-sm' href='/blog' style='ahead' />
      </Section>

      <Section title='Notes'>
        <ul class='flex flex-col gap-y-1.5 sm:gap-y-2'>
          {
            latestNotes.map((note) => (
              <li class='group/card relative flex flex-col rounded-2xl border bg-background px-5 py-2.5 transition-colors ease-in-out hover:bg-muted'>
                <a
                  class='group/link flex w-full flex-col transition-all hover:text-primary sm:flex-row'
                  href={`/archive/${note.id}`}
                  data-astro-prefetch
                >
                  <span class='min-w-[95px] py-1 text-xs text-muted-foreground'>
                    {archiveTypeLabels[note.data.type] || note.data.type}
                  </span>
                  <div class='z-10 flex-grow py-1'>{note.data.title}</div>
                </a>
              </li>
            ))
          }
        </ul>
        <Button title='Open page' class='w-fit self-end text-sm' href='/archive' style='ahead' />
      </Section>

      <Section title='Open Source'>
        <ProjectSection project={openSourceProjects} />
        <Button title='Open page' class='w-fit self-end text-sm' href='/projects' style='ahead' />
      </Section>

      <Section title='Education'>
        <div class='not-prose rounded-2xl border bg-muted px-6 py-5'>
          <div class='flex flex-col gap-y-1.5'>
            <h3
              class='w-fit text-lg font-medium text-foreground transition-colors hover:text-primary'
            >
              武昌工学院
            </h3>
            <p class='text-muted-foreground'>计算机科学与技术</p>
            <p class='text-muted-foreground'>2023年9月 - 2027年6月</p>
          </div>
        </div>
      </Section>

      <Section title='Skills'>
        <SkillLayout title='Languages' skills={languages} />
        <SkillLayout title='Frontend' skills={frontend} />
        <SkillLayout title='Backend' skills={backend} />
        <SkillLayout title='AI / Agent' skills={ai} />
        <SkillLayout title='Tools' skills={tools} />
      </Section>
    </div>

    <Quote class='mt-12' />
  </main>
</PageLayout>
